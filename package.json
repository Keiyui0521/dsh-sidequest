{
  "name": "dsh-sidequest",
  "version": "0.2.0",
  "description": "Nested side conversations and interactive HTML charts for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "Keiyui0521",
  "repository": {
    "type": "git",
    "url": "https://github.com/Keiyui0521/dsh-sidequest.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "src",
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY.md",
    "sidequest.config.example.json",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*test.mjs",
    "prepack": "npm run build",
    "format": "prettier --write src tests scripts index.js",
    "format:check": "prettier --check src tests scripts index.js",
    "test:package": "npm pack && node scripts/test-package.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "katex": "0.19.1",
    "marked": "18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "prettier": "3.10.1"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-message-quotes"
      ],
      "immediately": true
    }
  }
}
