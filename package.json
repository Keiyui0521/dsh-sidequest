{
  "name": "dsh-sidequest",
  "version": "0.1.0",
  "description": "Nested side conversations and interactive HTML charts for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "Keiyui0521",
  "repository": {
    "type": "git",
    "url": "https://github.com/Keiyui0521/dsh-sidequest.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "config.mjs",
    "ephemeral-server.mjs",
    "runtime/*.mjs",
    "dist/vendor.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY.md",
    "sidequest.config.example.json",
    "README.zh-CN.md",
    "docs/images"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node config-test.mjs && node client-state-test.mjs && node ephemeral-test.mjs && node visualization-test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "katex": "0.19.1",
    "marked": "18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-message-quotes"
      ],
      "immediately": true
    }
  }
}
